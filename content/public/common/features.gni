import("//build/config/features.gni")

declare_args() {
  # Whether or not to use external popup menu.
  use_external_popup_menu = is_apple && use_blink

  # Enables basic plugin support. This enables support for registering and
  # looking up plugins.
  #
  # In particular, the Desktop PDF viewer (enable_pdf) requires plugin support.
  enable_plugins = true

  # Enables separate renderer binary.
  enable_separate_renderer_binary = false
}

# Screen capture is enabled on most platforms.
enable_screen_capture = is_linux || (is_apple && use_blink)

assert(
    !enable_separate_renderer_binary || is_mac || is_linux,
    "Separate renderer binary is only supported on desktop platforms (macOS, Linux).")
