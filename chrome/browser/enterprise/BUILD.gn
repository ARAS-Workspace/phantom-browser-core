# Tests for files in the util/ subdirectory live here because util/BUILD.gn only
# contains Android Java targets (it imports //build/config/android/rules.gni,
# which asserts is_android and so cannot be loaded on other platforms).
source_set("unit_tests") {
  testonly = true

  sources = [ "util/managed_browser_utils_unittest.cc" ]

  deps = [
    ":impl",
    "//base",
    "//chrome/browser/content_settings:content_settings_factory",
    "//chrome/test:test_support",
    "//testing/gtest",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [ "util/managed_browser_utils_browsertest.cc" ]

  deps = [
    ":impl",
    "//base",
    "//chrome/browser/policy:test_support",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui/browser_window",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//content/test:test_support",
    "//testing/gmock",
  ]
}
