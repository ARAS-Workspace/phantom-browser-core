import("//extensions/buildflags/buildflags.gni")

source_set("enterprise") {
  public = [
    "browser_management/browser_management_service.h",
    "browser_management/browser_management_status_provider.h",
    "browser_management/management_service_factory.h",
    "util/affiliation.h",
    "util/managed_browser_utils.h",
  ]

  public_deps = [
    "//base",
    "//chrome/browser:browser_process",
    "//chrome/browser:main_extra_parts",
    "//chrome/browser/enterprise/browser_management:management_identity",
    "//chrome/browser/profiles",
    "//chrome/browser/profiles:profile_util",
    "//chrome/browser/signin",
    "//components/enterprise/buildflags",
    "//components/enterprise/common:files_scan_data",
    "//components/enterprise/common/proto:connectors_proto",
    "//components/enterprise/common/proto:legacy_tech_events_proto",
    "//components/keyed_service/content",
    "//components/keyed_service/core",
    "//components/os_crypt/async/browser",
    "//components/policy/core/browser",
    "//components/policy/core/common",
    "//components/prefs",
    "//components/reporting/client:report_queue_provider",
    "//components/security_interstitials/content:security_interstitial_page",
    "//components/security_interstitials/core",
    "//components/security_interstitials/core:unsafe_resource",
    "//components/signin/public/base",
    "//components/signin/public/base:signin_buildflags",
    "//components/signin/public/identity_manager",
    "//components/sync/service",
    "//components/url_matcher",
    "//content/public/browser",
    "//extensions/buildflags",
    "//services/data_decoder/public/cpp",
    "//ui/base/idle",
    "//url",
  ]

  public_deps += [
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/tabs:tab_strip_model_observer",
    "//chrome/browser/ui/webui/signin:signin_utils",
    "//chrome/browser/upgrade_detector:build_state_observer",
    "//ui/message_center/public/cpp",
    "//ui/views",
  ]

  # Circular deps: //chrome/browser/extensions,
  # //chrome/browser/ui, //chrome/browser/ui/webui/signin, and
  # //chrome/browser/ash/policy/core all depend on :enterprise via
  # browser_public_dependencies. Unconditional includes from those targets are
  # handled via allow_circular_includes_from on the respective owning targets.
  # Conditional includes guarded by #if BUILDFLAG() use nogncheck.
}

static_library("browser_launch_reporting") {
  sources = []
  deps = []
  if (is_linux || is_mac) {
    sources += [
      "reporting/browser_launch/scoped_initial_command_line.cc",
      "reporting/browser_launch/scoped_initial_command_line.h",
    ]
    deps += [ "//base" ]
  }
}

