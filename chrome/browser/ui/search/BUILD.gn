import("//build/config/chromeos/args.gni")

source_set("search") {
  sources = [
    "most_visited_metrics_logger.h",
    "ntp_user_data_logger.h",
    "ntp_user_data_types.h",
  ]
  public_deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/search",
    "//chrome/common",
    "//components/ntp_tiles",
    "//content/public/browser",
  ]
  sources += [
    "chrome_search_navigation_throttle.h",
    "omnibox_utils.h",
    "search_tab_helper.h",
  ]

  public_deps += [
    "//chrome/browser/ui/omnibox",
    "//chrome/browser/ui/tabs:tab_strip_model_observer",
    "//components/omnibox/common",
    "//mojo/public/cpp/bindings",
  ]
}

source_set("impl") {
  sources = [
    "most_visited_metrics_logger.cc",
    "ntp_user_data_logger.cc",
  ]
  deps = [
    ":search",
    "//base",
    "//chrome/browser:after_startup_task_utils",
    "//chrome/browser/search",
    "//chrome/browser/search/background",
    "//chrome/browser/search_engines",
    "//chrome/common",
    "//components/prefs",
    "//components/search",
  ]
  sources += [
    "chrome_search_navigation_throttle.cc",

    # The two files below cause circular dependencies against //c/b:b or
    # //c/b/ui:ui.
    "omnibox_utils.cc",
    "search_tab_helper.cc",
  ]
  deps += [
    "//chrome/browser:after_startup_task_utils",
    "//chrome/browser/bookmarks",
    "//chrome/browser/history",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/signin",
    "//chrome/browser/ui:tab_modal_confirm_dialog",
    "//chrome/browser/ui:tab_modal_confirm_dialog_delegate",
    "//chrome/browser/ui/bookmarks",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/location_bar",
    "//chrome/browser/ui/omnibox",
    "//chrome/browser/ui/tab_contents",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/browser/ui/user_education",
    "//components/bookmarks/browser",
    "//components/feature_engagement/public:feature_constants",
    "//components/navigation_metrics",
    "//components/profile_metrics",
    "//components/vector_icons",
    "//content/public/browser",
  ]

  public_deps = [ "//chrome/browser:browser_public_dependencies" ]
}

source_set("test_support_ui") {
  testonly = true
  sources = [
    "instant_test_base.cc",
    "instant_test_base.h",
    "ntp_test_utils.cc",
    "ntp_test_utils.h",
  ]
  public_deps = [ "//net:test_support" ]
  deps = [
    "//base",
    "//chrome/browser:browser_process",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/search",
    "//chrome/browser/search_engines",
    "//chrome/common",
    "//chrome/test:test_support",
    "//components/search_engines",
    "//url",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [
    "new_tab_page_navigation_throttle_browsertest.cc",
    "third_party_ntp_browsertest.cc",
  ]

  public_deps = [ "//net:test_support" ]
  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/search",
    "//chrome/browser/search_engines",
    "//chrome/browser/ui/search",
    "//chrome/browser/ui/search:test_support_ui",
    "//chrome/browser/ui/tab_contents",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/common",
    "//chrome/common:constants",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//components/network_session_configurator/common",
    "//components/search_engines",
    "//content/public/browser",
    "//content/test:test_support",
    "//url",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "chrome_search_navigation_throttle_unittest.cc",
    "most_visited_metrics_logger_unittest.cc",
    "ntp_user_data_logger_unittest.cc",
  ]
  deps = [
    ":impl",
    ":search",
    "//base",
    "//base/test:test_support",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/search",
    "//chrome/browser/search_engines",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/common",
    "//chrome/common:non_code_constants",
    "//chrome/test:test_support",
    "//components/favicon_base",
    "//components/ntp_tiles",
    "//components/omnibox/common",
    "//components/search",
    "//components/search_engines",
    "//content/public/browser",
    "//content/test:test_support",
    "//ipc",
    "//ipc:message_support",
    "//net",
    "//ui/base:types",
    "//url",
  ]
}
