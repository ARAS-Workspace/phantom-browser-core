  sources = [
    "new_tab_page_handler.cc",
    "new_tab_page_ui.cc",
    "untrusted_source.cc",
  ]
  public = [ "new_tab_page_handler.h" ]
  public_deps = [ "//chrome/browser:browser_public_dependencies" ]
  deps = [
    ":mojo_bindings",
    ":new_tab_page",
    "//base",
    "//base:i18n",
    "//chrome/app:branded_strings",
