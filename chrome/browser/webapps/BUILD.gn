source_set("webapps") {
  sources = [
    "chrome_webapps_client.h",
    "web_app_offline.h",
  ]

  public_deps = [
    "//components/webapps/browser",
    "//content/public/browser",
    "//content/public/common",
    "//url",
  ]
}

source_set("impl") {
  sources = [
    "chrome_webapps_client.cc",
    "web_app_offline.cc",
  ]

  deps = [
    ":webapps",
    "//base",
    "//chrome/browser/ssl",
    "//components/infobars/content",
    "//components/security_state/content",
    "//components/strings",
    "//components/webapps/browser",
    "//ui/base",
  ]

  deps += [ "//chrome/browser/web_applications" ]

  if (is_mac || is_linux) {
    deps += [ "//components/webapps/isolated_web_apps:scheme" ]
  }
}

source_set("desktop") {
  sources = [ "webapps_client_desktop.h" ]

  deps = [ ":webapps" ]
}

source_set("desktop_impl") {
  sources = [ "webapps_client_desktop.cc" ]

  deps = [
    ":desktop",
    ":webapps",
    "//base",
    "//chrome/browser/banners",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/segmentation_platform",
    "//chrome/browser/user_education",
    "//chrome/browser/web_applications",
    "//chrome/common",
    "//components/infobars/content",
    "//components/security_state/content",
    "//components/webapps/browser",
    "//content/public/browser",
  ]
}

source_set("interactive_ui_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  deps = [
    "//base",
    "//base/test:test_support",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui",
    "//chrome/browser/web_applications",
    "//chrome/browser/web_applications:web_applications_test_support",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//components/metrics:content",
    "//components/webapps/browser:test_support",
    "//content/test:test_support",
    "//net",
    "//skia",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/base",
    "//ui/gfx",
    "//ui/native_theme",
  ]
}
