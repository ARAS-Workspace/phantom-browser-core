import("//build/config/features.gni")
import("//chrome/common/features.gni")
import("//extensions/buildflags/buildflags.gni")

source_set("notifications") {
  public = [
    "displayed_notifications_dispatch_callback.h",
    "metrics/notification_metrics_logger.h",
    "metrics/notification_metrics_logger_factory.h",
    "non_persistent_notification_handler.h",
    "notification_blocker.h",
    "notification_common.h",
    "notification_display_queue.h",
    "notification_display_service.h",
    "notification_display_service_factory.h",
    "notification_display_service_impl.h",
    "notification_handler.h",
    "notification_permission_context.h",
    "notification_platform_bridge.h",
    "notification_platform_bridge_delegator.h",
    "notification_trigger_scheduler.h",
    "notifier_state_tracker.h",
    "notifier_state_tracker_factory.h",
    "persistent_notification_handler.h",
    "platform_notification_service_factory.h",
    "platform_notification_service_impl.h",
    "scheduler/notification_background_task_scheduler_impl.h",
    "scheduler/notification_schedule_service_factory.h",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/notifications/proto",
    "//chrome/browser/notifications/scheduler",
    "//chrome/browser/notifications/scheduler/public",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles/keep_alive",
    "//chrome/common:buildflags",
    "//chrome/common/notifications",
    "//components/content_settings/core/common",
    "//components/keyed_service/core",
    "//components/permissions",
    "//components/prefs",
    "//components/webapps/common",
    "//content/public/browser",
    "//content/public/common",
    "//extensions/buildflags",
    "//services/metrics/public/cpp:ukm_builders",
    "//ui/gfx",
    "//ui/message_center/public/cpp",
    "//url",
  ]

  deps = [ "//components/content_settings/core/browser" ]

  if (!is_android) {
    public += [
      "muted_notification_handler.h",
      "profile_notification.h",
    ]

    public_deps += [ "//components/keep_alive_registry" ]
  }

  if (is_win) {
    public += [
      "notification_platform_bridge_win.h",
      "win/notification_launch_id.h",
      "win/notification_metrics.h",
      "win/notification_template_builder.h",
      "win/notification_util.h",
    ]
  }

  if (is_mac) {
    public += [
      "mac/mac_notification_provider_factory.h",
      "mac/notification_dispatcher_mac.h",
      "mac/notification_dispatcher_mojo.h",
      "mac/notification_platform_bridge_mac.h",
      "mac/notification_utils.h",
    ]

    public_deps += [
      "//chrome/services/mac_notifications/public/cpp",
      "//chrome/services/mac_notifications/public/mojom",
      "//mojo/public/cpp/bindings",
    ]
  }

  if (is_linux) {
    if (use_dbus) {
      public += [ "notification_platform_bridge_linux.h" ]
    }
  }

  if (enable_chrome_notifications) {
    public += [
      "fullscreen_notification_blocker.h",
      "notification_platform_bridge_message_center.h",
      "notification_system_observer.h",
      "notification_ui_manager.h",
      "notification_ui_manager_impl.h",
      "popups_only_ui_controller.h",
      "screen_lock_notification_blocker.h",
    ]

    public_deps += [
      "//extensions/browser",
      "//ui/message_center",
    ]
  }

  # notifier_state_tracker.h conditionally includes extensions/browser headers.
  if (enable_extensions_core && !enable_chrome_notifications) {
    public_deps += [ "//extensions/browser" ]
  }
}

