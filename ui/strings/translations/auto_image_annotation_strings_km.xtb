<!DOCTYPE translationbundle>
<translationbundle lang="km">
<translation id="3591138502106622747">រូបភាពនេះ​មិនមាន​ស្លាកទេ។ សូមប្រើ​ប៊ូតុង "ជម្រើស​ច្រើនទៀត" នៅផ្នែក​ខាងលើនៃ​កម្មវិធីរុករកតាមអ៊ីនធឺណិត ដើម្បី​ទទួលបាន​ការពណ៌នា​អំពី​រូបភាព។</translation>
<translation id="3685101356851116974">រូបភាព​ដែលមិនបាន​ដាក់ស្លាក</translation>
<translation id="7118469954320184356">មិន​មាន​ការពណ៌នាទេ។</translation>
<translation id="7410239719251593705">មាន​ខ្លឹមសារ​សម្រាប់មនុស្ស​ពេញវ័យ។ មិន​មាន​ការពណ៌នាទេ។</translation>
<translation id="7533959249147584474">ក្រាហ្វិកដែល​មិនបាន​ដាក់ស្លាក</translation>
<translation id="7745230546936012372">ដើម្បី​ទទួលបាន​ការពណ៌នា​អំពី​រូបភាព​ដែលបាត់ សូម​បើកម៉ឺនុយ​បរិបទ។</translation>
<translation id="811583516810654505">កំពុង​ទាញយក​ការពណ៌នា...</translation>
</translationbundle>