<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sq">
<translation id="3591138502106622747">Ky imazh nuk është i etiketuar. Përdor butonin "Më shumë opsione" në krye të shfletuesit për të marrë përshkrimet e imazheve.</translation>
<translation id="3685101356851116974">Imazh i paetiketuar</translation>
<translation id="7118469954320184356">Nuk ka asnjë përshkrim.</translation>
<translation id="7410239719251593705">Duket se ka përmbajtje për të rritur. Nuk ka asnjë përshkrim.</translation>
<translation id="7533959249147584474">Grafikë e paetiketuar</translation>
<translation id="7745230546936012372">Për të marrë përshkrimet e imazheve që mungojnë, hap menynë e kontekstit.</translation>
<translation id="811583516810654505">Po merr përshkrimin...</translation>
</translationbundle>