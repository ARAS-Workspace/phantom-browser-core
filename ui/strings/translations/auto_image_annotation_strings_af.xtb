<!DOCTYPE translationbundle>
<translationbundle lang="af">
<translation id="3591138502106622747">Hierdie prent is nie geëtiketteer nie. Gebruik die Meer Opsies-knoppie boaan die blaaier om prentbeskrywings te kry.</translation>
<translation id="3685101356851116974">Etiketlose prent</translation>
<translation id="7118469954320184356">Geen beskrywing is beskikbaar nie.</translation>
<translation id="7410239719251593705">Dit lyk of dit volwassene-inhoud bevat. Geen beskrywing is beskikbaar nie.</translation>
<translation id="7533959249147584474">Etiketlose grafika</translation>
<translation id="7745230546936012372">Maak die inhoudkieslys oop om ontbrekende prentbeskrywings te kry.</translation>
<translation id="811583516810654505">Kry tans beskrywing …</translation>
</translationbundle>