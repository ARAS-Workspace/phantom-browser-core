<!DOCTYPE translationbundle>
<translationbundle lang="zu">
<translation id="3591138502106622747">Lesi sithombe asilebuliwe. Sebenzisa inkinobho yongakhetha kukho okuningi ngaphezu kwebhrawuza ukuze uthole izincazelo zesithombe.</translation>
<translation id="3685101356851116974">Isithombe esingenalebuli</translation>
<translation id="7118469954320184356">Ayikho incazelo ekhona.</translation>
<translation id="7410239719251593705">Ibonakala iqukethe kwabadala. Ayikho incazelo ekhona.</translation>
<translation id="7533959249147584474">Imifanekiso engenalebuli</translation>
<translation id="7745230546936012372">Ukuze uthole izincazelo zesithombe ezingekho, vula imenyu yokuqukethwe.</translation>
<translation id="811583516810654505">Ithola incazelo...</translation>
</translationbundle>