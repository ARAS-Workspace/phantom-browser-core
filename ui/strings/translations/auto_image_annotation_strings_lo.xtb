<!DOCTYPE translationbundle>
<translationbundle lang="lo">
<translation id="3591138502106622747">ຮູບນີ້ບໍ່ມີປ້າຍກຳກັບ. ໃຊ້ປຸ່ມຕົວເລືອກເພີ່ມເຕີມຢູ່ເທິງສຸດຂອງໂປຣແກຣມທ່ອງເວັບເພື່ອເບິ່ງຄຳອະທິບາຍຮູບ.</translation>
<translation id="3685101356851116974">ຮູບທີ່ບໍ່ມີປ້າຍກຳກັບ</translation>
<translation id="7118469954320184356">ບໍ່ມີລາຍລະອຽດ.</translation>
<translation id="7410239719251593705">ປາກົດວ່າປະກອບມີເນື້ອຫາສຳລັບຜູ້ໃຫຍ່. ບໍ່ມີລາຍລະອຽດ.</translation>
<translation id="7533959249147584474">ກຣາຟິກທີ່ບໍ່ມີປ້າຍກຳກັບ</translation>
<translation id="7745230546936012372">ເພື່ອຮັບລາຍລະອຽດຮູບພາບທີ່ຫາຍໄປ, ກະລຸນາເປີດເມນູກົດຄ້າງ.</translation>
<translation id="811583516810654505">ກຳລັງຮັບເອົາລາຍລະອຽດ...</translation>
</translationbundle>