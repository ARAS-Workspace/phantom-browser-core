<!DOCTYPE translationbundle>
<translationbundle lang="si">
<translation id="3591138502106622747">මෙම රූපය ලේබල් කර නැත. රූප විස්තර ලබා ගැනීමට බ්‍රව්සරයේ ඉහළින් ඇති තවත් විකල්ප බොත්තම භාවිතා කරන්න.</translation>
<translation id="3685101356851116974">ලේබල් නොකළ රූපය</translation>
<translation id="7118469954320184356">විස්තරයක් ලබා ගත නොහැක.</translation>
<translation id="7410239719251593705">වැඩිහිටි අන්තර්ගතය අඩංගු ලෙස පෙනේ. විස්තරයක් ලබා ගත නොහැක.</translation>
<translation id="7533959249147584474">ලේබල් නොකළ චිත්‍රකය</translation>
<translation id="7745230546936012372">මඟ හැරුණු රූප විස්තර කිරීම් ලබා ගැනීමට, ප්‍රකරණ මෙනුව විවෘත කරන්න</translation>
<translation id="811583516810654505">විස්තරය ලබා ගැනීම...</translation>
</translationbundle>