<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="mk">
<translation id="3591138502106622747">Сликава нема етикета. Користете го копчето за повеќе опции најгоре во прелистувачот за да добиете описи на сликата.</translation>
<translation id="3685101356851116974">Слика без етикета</translation>
<translation id="7118469954320184356">Нема достапен опис.</translation>
<translation id="7410239719251593705">Се чини дека вклучува содржини за возрасни. Нема достапен опис.</translation>
<translation id="7533959249147584474">Графички приказ без етикета</translation>
<translation id="7745230546936012372">За да ги добиете описите на сликите што недостасуваат, отворете го контекстуалното мени.</translation>
<translation id="811583516810654505">Се добива описот...</translation>
</translationbundle>