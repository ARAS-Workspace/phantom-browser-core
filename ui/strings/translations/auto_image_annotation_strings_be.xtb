<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="be">
<translation id="3591138502106622747">Гэты відарыс не мае метак. Каб паглядзець апісанне відарысаў, націсніце кнопку дадатковых параметраў у верхняй частцы браўзера.</translation>
<translation id="3685101356851116974">Відарыс без цэтліка</translation>
<translation id="7118469954320184356">Няма апісання.</translation>
<translation id="7410239719251593705">Узнікае для паведамлення пра змесціва для дарослых. Няма апісання.</translation>
<translation id="7533959249147584474">Відарыс без апісання</translation>
<translation id="7745230546936012372">Каб атрымаць адсутныя апісанні відарысаў, адкрыйце кантэкстнае меню.</translation>
<translation id="811583516810654505">Ідзе атрыманне апісання...</translation>
</translationbundle>