<!DOCTYPE translationbundle>
<translationbundle lang="ne">
<translation id="3591138502106622747">यो फोटोमा लेबल लगाइएको छैन। फोटोका विवरणहरू प्राप्त गर्न ब्राउजरको सिरानमा रहेको "थप विकल्पहरू" बटन प्रयोग गर्नुहोस्।</translation>
<translation id="3685101356851116974">लेबल प्रदान नगरिएको फोटो</translation>
<translation id="7118469954320184356">कुनै पनि विवरण उपलब्ध छैन।</translation>
<translation id="7410239719251593705">वयस्क सामग्री समावेश छ जस्तो देखिन्छ। कुनै पनि विवरण उपलब्ध छैन।</translation>
<translation id="7533959249147584474">लेबल प्रदान नगरिएको ग्राफिक</translation>
<translation id="7745230546936012372">छविका हराएका वर्णनहरू प्राप्त गर्न सन्दर्भ मेनु खोल्नुहोस्।</translation>
<translation id="811583516810654505">विवरण प्राप्त गर्दै...</translation>
</translationbundle>