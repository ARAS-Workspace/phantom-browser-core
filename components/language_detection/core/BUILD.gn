import("//build/config/features.gni")
import("//testing/test.gni")

# We need a component because this gives access to a per-process
# singleton instance of the model. Without a component, we end up an
# instance in each component that uses the library.
component("core") {
  _configs = configs
  configs = []
  configs = [ "//third_party/tflite:tflite_shim_config" ] + _configs
  sources = [
    "background_file.cc",
    "background_file.h",
    "chinese_script_classifier.cc",
    "chinese_script_classifier.h",
    "constants.h",
    "features.cc",
    "features.h",
    "language_detection_details.cc",
    "language_detection_details.h",
    "language_detection_driver.cc",
    "language_detection_driver.h",
    "language_detection_metrics.cc",
    "language_detection_metrics.h",
    "language_detection_model.cc",
    "language_detection_model.h",
    "language_detection_util.cc",
    "language_detection_util.h",
    "language_matcher.cc",
    "language_matcher.h",
    "page_language_detector.cc",
    "page_language_detector.h",
  ]
  if (use_blink) {
    sources += [
      "language_detection_provider.cc",
      "language_detection_provider.h",
    ]
  }
  deps = [
    ":internals",
    "//base",
    "//base:i18n",
    "//components/language/core/common",
    "//components/optimization_guide/core:features",
    "//third_party/cld_3/src/src:cld_3",
    "//third_party/icu",
    "//third_party/tflite",
    "//third_party/tflite_support",
    "//third_party/tflite_support:tflite_support_proto",
    "//url",
  ]
  defines = [ "IS_LANGUAGE_DETECTION_IMPL" ]
}

static_library("internals") {
  _configs = configs
  configs = []
  configs = [ "//third_party/tflite:tflite_shim_config" ] + _configs
  visibility = [
    ":core",
    ":unit_tests",
  ]
  sources = [
    "embedding_lookup.cc",
    "embedding_lookup.h",
    "language_detection_resolver.h",
    "ngram_hash.cc",
    "ngram_hash.h",
    "ngram_hash_ops_utils.cc",
    "ngram_hash_ops_utils.h",
    "quantization_utils.cc",
    "quantization_utils.h",
  ]

  deps = [
    "//base",
    "//third_party/smhasher:murmurhash2",
    "//third_party/tflite",
    "//third_party/utf",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "background_file_unittest.cc",
    "chinese_script_classifier_test.cc",
    "language_detection_metrics_unittest.cc",
    "language_detection_model_unittest.cc",
    "language_detection_util_unittest.cc",
    "language_matcher_unittest.cc",
    "ngram_hash_ops_utils_unittest.cc",
    "page_language_detector_unittest.cc",
    "quantization_utils_unittest.cc",
  ]
  if (use_blink) {
    sources += [ "language_detection_provider_unittest.cc" ]
  }

  deps = [
    ":core",
    ":internals",
    "//base",
    "//base:i18n",
    "//base/test:test_support",
    "//components/language_detection/testing",
  ]
}

test("language_detection_util_fuzztest") {
  sources = [ "language_detection_util_fuzztest.cc" ]
  fuzztests =
      [ "LanguageDetectionUtilFuzzTest.DeterminePageLanguageDoesNotCrash" ]

  deps = [
    ":core",
    "//testing/gtest",
    "//third_party/fuzztest:fuzztest_gtest_main",
  ]
}
