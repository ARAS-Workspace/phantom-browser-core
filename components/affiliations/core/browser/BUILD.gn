source_set("affiliations") {
  sources = [
    "affiliation_utils.cc",
    "affiliation_utils.h",
  ]
  deps = [
    "//base",
    "//components/url_formatter",
    "//net",
  ]
  public_deps = [ "//url" ]
  configs += [ "//build/config/compiler:wexit_time_destructors" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "affiliation_utils_unittest.cc" ]
  deps = [
    ":affiliations",
    "//base",
    "//testing/gmock",
    "//testing/gtest",
    "//url",
  ]
}
