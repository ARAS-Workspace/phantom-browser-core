import("//mojo/public/tools/bindings/mojom.gni")

source_set("pref_names") {
  sources = [ "pref_names.h" ]
  public_deps = [
    "//build:android_buildflags",
    "//build:branding_buildflags",
  ]
}

static_library("ntp_tiles") {
  sources = [
    "constants.cc",
    "constants.h",
    "custom_links_manager.h",
    "custom_links_manager_impl.cc",
    "custom_links_manager_impl.h",
    "custom_links_store.cc",
    "custom_links_store.h",
    "custom_links_util.h",
    "enterprise/enterprise_shortcut.cc",
    "enterprise/enterprise_shortcut.h",
    "enterprise/enterprise_shortcuts_manager.h",
    "icon_cacher.h",
    "metrics.cc",
    "metrics.h",
    "most_visited_sites.cc",
    "most_visited_sites.h",
    "ntp_tile.cc",
    "ntp_tile.h",
    "ntp_tile_impression.cc",
    "ntp_tile_impression.h",
    "popular_sites.cc",
    "popular_sites.h",
    "section_type.h",
    "tile_source.h",
    "tile_title_source.h",
    "tile_type.h",
    "tile_visual_type.h",
    "webui/ntp_tiles_internals_message_handler.cc",
    "webui/ntp_tiles_internals_message_handler.h",
    "webui/ntp_tiles_internals_message_handler_client.cc",
    "webui/ntp_tiles_internals_message_handler_client.h",
  ]

  public_deps = [
    "//base",
    "//components/history/core/browser",
    "//components/ntp_tiles/webui/resources",
  ]
  deps = [
    ":mojo_bindings",
    ":pref_names",
    "//components/favicon/core",
    "//components/favicon_base",
    "//components/pref_registry",
    "//components/prefs",
    "//components/search",
    "//components/strings",
    "//components/url_formatter",
    "//third_party/re2",
  ]

  if (is_linux || is_mac) {
    sources += [
      "enterprise/enterprise_shortcuts_manager_impl.cc",
      "enterprise/enterprise_shortcuts_manager_impl.h",
      "enterprise/enterprise_shortcuts_store.cc",
      "enterprise/enterprise_shortcuts_store.h",
      "enterprise/ntp_shortcuts_policy_handler.cc",
      "enterprise/ntp_shortcuts_policy_handler.h",
    ]
    deps += [
      "//components/policy/core/browser",
      "//components/policy/core/common",
    ]
  }
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "custom_links_manager_impl_unittest.cc",
    "custom_links_store_unittest.cc",
    "metrics_unittest.cc",
    "most_visited_sites_unittest.cc",
  ]

  deps = [
    ":ntp_tiles",
    ":pref_names",
    "//base/test:test_support",
    "//components/history/core/test",
    "//components/prefs",
    "//components/search",
    "//components/sync_preferences:test_support",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/base",
  ]

  if (is_linux || is_mac) {
    sources += [
      "enterprise/enterprise_shortcuts_manager_impl_unittest.cc",
      "enterprise/enterprise_shortcuts_store_unittest.cc",
      "enterprise/ntp_shortcuts_policy_handler_unittest.cc",
    ]
    deps += [ "//components/policy/core/browser:test_support" ]

    # TODO(crbug.com/40031409): Fix code that adds exit-time destructors and
    # enable the diagnostic by removing this line.
    configs += [ "//build/config/compiler:no_exit_time_destructors" ]
  }
}

mojom("mojo_bindings") {
  sources = [
    "tile_source.mojom",
    "tile_type.mojom",
  ]
  webui_module_path = "chrome://resources/mojo/components/ntp_tiles/"
}
