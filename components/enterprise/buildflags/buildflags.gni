import("//build/config/chromeos/args.gni")
import("//build/config/ui.gni")

declare_args() {
  # Indicates support for Data Control rules.
  enterprise_data_controls =
      is_win || is_mac || is_linux || is_android || is_ios

  # Indicates support for client certificates provisioning.
  # iOS support is currently under development
  enterprise_client_certificates =
      is_win || is_mac || is_linux || is_android || is_ios

  # Indicates support for watermark.
  enterprise_watermark = is_win || is_mac || is_linux || is_ios

  enterprise_screenshot_protection = is_win || is_mac || is_ios || is_android

  # Support on all platforms except for iOS since it uses `WKWebView` cache.
  enterprise_cache_encryption = is_win || is_mac || is_linux || is_android

  # Indicates support for Enterprise Proxy policy and service.
  enterprise_proxy = is_win || is_mac || is_linux || is_android || is_ios
}
