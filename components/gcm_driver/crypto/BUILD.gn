import("//crypto/features.gni")

static_library("crypto") {
  sources = [
    "gcm_message_cryptographer.cc",
    "gcm_message_cryptographer.h",
    "p256_key_util.cc",
    "p256_key_util.h",
    "rfc8291_util.cc",
    "rfc8291_util.h",
  ]

  deps = [
    "//base",
    "//crypto",
    "//net",
    "//third_party/boringssl",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "p256_key_util_unittest.cc",
    "rfc8291_util_unittest.cc",
  ]

  deps = [
    ":crypto",
    "//base",
    "//crypto",
    "//testing/gtest",
  ]
}
