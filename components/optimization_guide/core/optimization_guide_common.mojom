  SERVICE_AND_SETTINGS,
  HINTS,
  MODEL_MANAGEMENT,
  PAGE_CONTENT_ANNOTATIONS,
  HINTS_NOTIFICATIONS,
  TEXT_CLASSIFIER,
  MODEL_EXECUTION,
  NTP_MODULE,
  CONTEXTUAL_TASKS_CONTEXT,
};
