# Cast support is removed from this tree. The two flags below stay defined
# because third_party checkouts read them: third_party/ffmpeg/ffmpeg_options.gni
# imports this file directly and third_party/angle/gni/angle.gni reads is_castos
# through //build/config/ozone.gni. Both are separate checkouts, so a change
# there cannot be committed with this tree.
#
# They are plain assignments rather than declare_args() entries, so the values
# cannot be set from the command line.

declare_args() {
  # If non empty, rpath of executables is set to this.
  # If empty, default value is used.
  target_rpath = ""
}

is_castos = false
is_cast_android = false
